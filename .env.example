# Copy to .env on the home server and fill in real values. Never commit .env.

# Port the app listens on inside and outside the container (both the ASPNETCORE_URLS
# binding and the published host port follow this single value).
APP_PORT=8080

POSTGRES_DB=loreweaver
POSTGRES_USER=loreweaver
POSTGRES_PASSWORD=change_me_to_a_long_random_secret

# Optional: only needed once the LiveKit stack (deploy/livekit/) is deployed too.
# Leave blank to run without session video/voice/screen-share.
LIVEKIT_WEBSOCKET_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
