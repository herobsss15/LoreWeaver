# Copy to .env on the home server and fill in real values. Never commit .env.

# LiveKit API key/secret pair used to sign room-access JWTs (server-side only — the
# app's token-minting service uses these; they must never reach the browser).
# ApiSecret must be at least 256 bits (32 bytes) — the .NET server SDK rejects
# anything shorter at startup. `openssl rand -base64 32` is long enough.
LIVEKIT_API_KEY=lk_change_me
LIVEKIT_API_SECRET=change_me_to_a_long_random_secret_at_least_32_bytes

# Hostname clients use to reach coturn from the internet. A DDNS hostname is
# recommended if the home connection doesn't have a static IP.
TURN_PUBLIC_HOST=turn.example.com

# coturn's external-ip mapping: <public-ip>/<private-lan-ip-of-this-host> — both must
# be literal IPs (see turnserver.conf.template for why).
TURN_PUBLIC_IP_MAPPING=203.0.113.1/192.168.1.50

# Shared long-term TURN credential used by all participants.
TURN_USERNAME=loreweaver
TURN_PASSWORD=change_me_to_a_long_random_secret
